[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{%- if author_name %}
authors = [{ name = "{{ author_name }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }]
{%- endif %}
classifiers = ["Private :: Do Not Upload"]
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[dependency-groups]
dev = [
    "codeaudit>=1.9",
    "commitizen>=4.0",
    "deptry>=0.20",
    "import-linter>=2.1",
    "pip-audit>=2.7",
    "pre-commit>=4.0",
    "pylint>=3.3",
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "radon>=6.0",
    "ruff>=0.8",
    "rust-just>=1.38",
    "ty>=0.0.1a1",
    "vulture>=2.11",
    "xenon>=0.9",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]
output-format = "concise"

[tool.ruff.lint]
select = [
    "E",     # pycodestyle errors
    "F",     # pyflakes
    "W",     # pycodestyle warnings
    "I",     # isort
    "B",     # flake8-bugbear
    "UP",    # pyupgrade
    "SIM",   # flake8-simplify
    "C4",    # flake8-comprehensions
    "C90",   # mccabe complexity
    "RUF",   # ruff-specific
    "PT",    # flake8-pytest-style
    "PL",    # pylint (refactor, structural limits, errors, warnings)
    "ERA",   # eradicate (no commented-out code)
    "ARG",   # flake8-unused-arguments
    "T20",   # flake8-print (no print in production code)
    "S",     # flake8-bandit (security)
    "ANN",   # flake8-annotations (require type annotations)
    "TC",    # flake8-type-checking (type-only imports)
    "PIE",   # flake8-pie
    "FURB",  # refurb
    "PERF",  # perflint
    "RET",   # flake8-return
    "TID",   # flake8-tidy-imports
    "PGH",   # pygrep-hooks (require specific codes on noqa / type: ignore)
    "BLE",   # flake8-blind-except (no bare except Exception)
    "DTZ",   # flake8-datetimez (require timezone-aware datetimes)
    "ASYNC", # flake8-async (no blocking calls in async functions)
    "PTH",   # flake8-use-pathlib (prefer pathlib.Path over os.path)
    "A",     # flake8-builtins (no shadowing Python builtins)
    "N",     # pep8-naming (standard Python naming conventions)
    "LOG",   # flake8-logging (proper logger usage)
    "G",     # flake8-logging-format (no f-strings/concatenation in log calls)
    "RSE",   # flake8-raise (no unnecessary parens on raise)
    "ISC",   # flake8-implicit-str-concat
    "SLOT",  # flake8-slots (require __slots__ on builtin subclasses)
]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]
combine-as-imports = true

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.pylint]
max-args = 5
max-branches = 10
max-returns = 5
max-statements = 40

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101", "PLR2004", "ANN401"]

[tool.ruff.format]
docstring-code-format = true

[tool.deptry]
extend_exclude = ["tests"]

[tool.vulture]
paths = ["src", "tests"]
min_confidence = 80
sort_by_size = true
ignore_decorators = ["@pytest.fixture"]

[tool.importlinter]
root_package = "{{ package_name }}"

[[tool.importlinter.contracts]]
name = "No circular imports between sibling modules"
type = "acyclic_siblings"
ancestors = ["{{ package_name }}"]

[tool.pylint.main]
files = ["src", "tests"]

[tool.pylint."messages control"]
disable = ["all"]
enable = ["duplicate-code", "too-many-lines"]

[tool.pylint.format]
max-module-lines = 300

[tool.pylint.reports]
score = false

[tool.pylint.similarities]
min-similarity-lines = 6
ignore-comments = true
ignore-docstrings = true
ignore-imports = true
ignore-signatures = true

[tool.pytest.ini_options]
testpaths = ["tests", "src"]
addopts = "-q --tb=short --strict-markers --strict-config --doctest-modules --no-cov-on-fail"
xfail_strict = true
filterwarnings = ["error"]

[tool.coverage.run]
source = ["src/{{ package_name }}"]
branch = true

[tool.coverage.report]
fail_under = 80
show_missing = true
skip_covered = true
exclude_also = [
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "@(abc\\.)?abstractmethod",
    "class .*\\bProtocol\\):",
]

[tool.commitizen]
name = "cz_conventional_commits"
version_provider = "uv"
version_files = ["src/{{ package_name }}/__init__.py:__version__"]
tag_format = "v$version"
update_changelog_on_bump = true
major_version_zero = true
