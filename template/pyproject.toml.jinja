[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{%- if author_name %}
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{%- endif %}
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[dependency-groups]
dev = [
    "commitizen>=4.0",
    "deptry>=0.20",
    "import-linter>=2.1",
    "pre-commit>=4.0",
    "pylint>=3.3",
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "radon>=6.0",
    "ruff>=0.8",
    "ty>=0.0.1a1",
    "vulture>=2.11",
    "xenon>=0.9",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]
output-format = "concise"

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "F",    # pyflakes
    "W",    # pycodestyle warnings
    "I",    # isort
    "B",    # flake8-bugbear
    "UP",   # pyupgrade
    "SIM",  # flake8-simplify
    "C4",   # flake8-comprehensions
    "C90",  # mccabe complexity
    "RUF",  # ruff-specific
    "PT",   # flake8-pytest-style
    "PL",   # pylint (refactor, structural limits, errors, warnings)
    "ERA",  # eradicate (no commented-out code)
    "ARG",  # flake8-unused-arguments
    "T20",  # flake8-print (no print in production code)
    "S",    # flake8-bandit (security)
    "ANN",  # flake8-annotations (require type annotations)
    "TC",   # flake8-type-checking (type-only imports)
    "PIE",  # flake8-pie
    "FURB", # refurb
    "PERF", # perflint
    "RET",  # flake8-return
    "TID",  # flake8-tidy-imports
]

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.pylint]
max-args = 5
max-branches = 10
max-returns = 5
max-statements = 40

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101", "PLR2004"]

[tool.ruff.format]
docstring-code-format = true

[tool.deptry]
extend_exclude = ["tests"]

[tool.vulture]
paths = ["src", "tests"]
min_confidence = 80
sort_by_size = true
ignore_decorators = ["@pytest.fixture"]

[tool.importlinter]
root_package = "{{ package_name }}"

[[tool.importlinter.contracts]]
name = "No circular imports between sibling modules"
type = "acyclic_siblings"
ancestors = ["{{ package_name }}"]

[tool.pylint.main]
files = ["src", "tests"]

[tool.pylint."messages control"]
disable = ["all"]
enable = ["duplicate-code"]

[tool.pylint.reports]
score = false

[tool.pylint.similarities]
min-similarity-lines = 6
ignore-comments = true
ignore-docstrings = true
ignore-imports = true
ignore-signatures = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --tb=short --strict-markers --strict-config"

[tool.coverage.run]
source = ["src/{{ package_name }}"]
branch = true

[tool.coverage.report]
fail_under = 80
show_missing = true
skip_covered = true
exclude_also = ["if TYPE_CHECKING:", "raise NotImplementedError"]

[tool.commitizen]
name = "cz_conventional_commits"
version_provider = "uv"
tag_format = "v$version"
update_changelog_on_bump = true
major_version_zero = true
